{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "honeyconf_machines_spec.json",
  "title": "honeyconf.sh machines index specification",
  "description": "A declaration of machines configuration",
  "type": "object",
  "properties": {
    "machines": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "$ref": "#/$defs/machine"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "machine": {
      "type": "object",
      "properties": {
        "managed": {
          "type": "boolean",
          "default": true,
          "description": "Whether the machine is targeted by deploy.sh, execute.sh and profile_all.sh. Set to false to skip it."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "application_server",
              "backup_server"
            ]
          },
          "uniqueItems": true
        },
        "options": {
          "type": "object",
          "properties": {
            "manage_hostname": {
              "type": "boolean",
              "default": true,
              "description": "Set /etc/hostname, the running hostname and the 127.0.1.1 entry of /etc/hosts to the machine name."
            },
            "manage_fail2ban": {
              "type": "boolean",
              "default": true,
              "description": "Install fail2ban."
            },
            "manage_updatedb": {
              "type": "boolean",
              "default": true,
              "description": "Exclude /mnt and aufs from updatedb (mlocate) indexing."
            },
            "disable_ssh_password_authentication": {
              "type": "boolean",
              "default": true,
              "description": "Force 'PasswordAuthentication no' in /etc/ssh/sshd_config."
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "dmz": {
              "$ref": "#/$defs/network"
            },
            "internal": {
              "$ref": "#/$defs/network"
            },
            "public": {
              "$ref": "#/$defs/network"
            },
            "dialin": {
              "$ref": "#/$defs/network"
            }
          },
          "additionalProperties": false
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "node_exporter"
              ]
            },
            "source": {
              "type": "string",
              "default": "package",
              "enum": [
                "package",
                "upstream-1.2.2"
              ]
            },
            "tls_ca": {
              "type": "string"
            },
            "tls_cert": {
              "type": "string"
            },
            "tls_key": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "swap": {
          "type": "object",
          "properties": {
            "size_mb": {
              "type": "integer",
              "minimum": 1,
              "description": "Size of /swapfile in megabytes. Only applied when /swapfile does not exist yet."
            }
          },
          "required": [
            "size_mb"
          ],
          "additionalProperties": false
        },
        "credentials": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "description": "SSH login used by deploy.sh, execute.sh and profile_all.sh. Must be allowed to run sudo."
            },
            "password": {
              "type": "string",
              "description": "Not used by honeyconf.sh."
            }
          },
          "required": [
            "username"
          ]
        },
        "access_control": {
          "type": "object",
          "properties": {
            "authorized_keys": {
              "type": "string"
            },
            "authorized_keys_user": {
              "type": "string",
              "description": "Keys are written to /home/<user>/.ssh/authorized_keys unless authorized_keys_file is set."
            },
            "authorized_keys_additional": {
              "type": "string"
            },
            "authorized_keys_file": {
              "type": "string"
            },
            "service_accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "home": {
                    "type": "string"
                  },
                  "authorized_keys": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z_][a-z0-9_-]*$"
                    },
                    "uniqueItems": true
                  },
                  "sudo": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "username",
                  "home"
                ],
                "additionalProperties": false
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "authorized_keys_file"
              ]
            },
            {
              "required": [
                "authorized_keys_user"
              ]
            }
          ],
          "additionalProperties": false
        },
        "mounts": {
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": {
              "$ref": "#/$defs/mount"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "system": {
          "type": "object",
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "contents": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "managed": {
          "type": "boolean",
          "default": false,
          "description": "Only managed networks are written to disk."
        },
        "interface": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "default": "static",
          "enum": [
            "static",
            "dhcp",
            "manual"
          ]
        },
        "state": {
          "type": "string",
          "default": "up",
          "enum": [
            "up",
            "down"
          ],
          "description": "'down' forces mode to 'manual' and stops ifup@<interface>.service."
        },
        "ip": {
          "type": "string",
          "description": "Address in CIDR notation, used when mode is static."
        },
        "gateway": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "net": {
                "type": "string",
                "description": "CIDR"
              },
              "gateway": {
                "type": "string"
              }
            },
            "required": [
              "net",
              "gateway"
            ],
            "additionalProperties": false
          }
        },
        "nameservers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "string",
          "default": "ext4",
          "description": "Any filesystem other than zfs is mounted through /etc/fstab at /mnt/external_storage/<name>."
        },
        "encrypted": {
          "type": "boolean",
          "default": false,
          "description": "Open every device as a LUKS container before use."
        },
        "encryption_key": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "description": "Takes precedence over device. Only the first device is mounted for non-zfs filesystems.",
          "items": {
            "type": "string"
          }
        },
        "folders": {
          "type": "array",
          "description": "Folders created inside /mnt/external_storage/<name>. Ignored for zfs.",
          "items": {
            "type": "string"
          }
        },
        "datasets": {
          "type": "array",
          "description": "ZFS datasets. Ignored for other filesystems.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mountpoint": {
                "type": "string"
              },
              "compression": {
                "type": "string"
              },
              "encryption": {
                "type": "string"
              },
              "encryption_passphrase": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "mountpoint"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
